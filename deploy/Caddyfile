# Caddy: TLS (Let's Encrypt) and a reverse proxy to the gateway at 127.0.0.1:8080.
# Installed by setup.sh to /etc/caddy/Caddyfile: setup.sh substitutes the domain for the placeholder
# in the first line of the site block (sed replacement on the "{$DOMAIN}" line).
#
# Lines marked "#cf " are enabled only with setup.sh --behind-cloudflare (a domain with the orange
# cloud): Caddy trusts the CF-Connecting-IP header only from Cloudflare addresses
# (www.cloudflare.com/ips, checked 2026-11-02), otherwise the login lockout would see one Cloudflare IP for everyone.
{
	servers {
		# HTTP/3 is off: nftables does not open UDP 443, and the advertised Alt-Svc h3 made browsers wait for QUIC (staging review R-2)
		protocols h1 h2
#cf 		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
#cf 		trusted_proxies_strict
#cf 		client_ip_headers CF-Connecting-IP
	}
	# Caddy service log (reverse_proxy errors and so on, goes to journald): the same filters as the access log,
	# and no client port. Without them journald received the query, headers and the full IP (staging review R-1).
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" ""
				request>headers delete
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
				request>remote_port delete
			}
		}
	}
}

{$DOMAIN} {
	# Authenticated Origin Pulls (N-11, behind Cloudflare only): the TLS handshake succeeds only with the Cloudflare
	# client certificate, so direct connections to the server IP (and a forged CF-Connecting-IP) are rejected.
	# The operator places the CA, setup.sh checks its fingerprint (see docs/DEPLOY.md). trust_pool syntax: Caddy 2.7+.
	#cf tls {
	#cf 	client_auth {
	#cf 		mode require_and_verify
	#cf 		trust_pool file /etc/caddy/cloudflare-origin-pull-ca.pem
	#cf 	}
	#cf }

	# Request body: Deepgram accepts files up to 200 MB, so the limit at the entrance is 210 MB.
	# The general body limit of 2 MB for other requests is enforced by the application itself.
	request_body {
		max_size 210MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Access log without the query string and without request headers (spec section 9: Caddy without query/headers).
	# The IP is masked to /16 (IPv4) and /32 (IPv6).
	# The Caddy 2 filter syntax (format filter, regexp, ip_mask) was checked on Caddy 2.11.
	# One-time login links /l/<token> and /setup/<code> carry a secret in the path: they are not logged at all.
	@secret_paths path /l/* /setup/*
	log_skip @secret_paths

	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" ""
				request>headers delete
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
			}
		}
	}

	reverse_proxy 127.0.0.1:8080 {
		# Streaming responses (proxy to services) are passed without buffering
		flush_interval -1
		# Pass the gateway a single client address, not a chain: otherwise Fastify (trustProxy loopback)
		# would take the Cloudflare address from the chain.
		header_up X-Forwarded-For {client_ip}
		# Deepgram answers within 600 s; wait for response headers longer than the provider does.
		transport http {
			response_header_timeout 620s
		}
	}
}
