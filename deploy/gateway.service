# systemd unit of the AgentKeyGate service. Installed by setup.sh to /etc/systemd/system/gateway.service.

[Unit]
Description=AgentKeyGate (temporary API access gateway for AI agents)
Documentation=file:///opt/agentkeygate/app/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target
# Never stop retrying after failures (fail-closed: agents get 503, the unit does not give up).
StartLimitIntervalSec=0

[Service]
Type=simple
# The gateway user is created by setup.sh as a system user (no shell).
# DynamicUser is intentionally not used: a stable uid is needed, because
# ownership of /var/lib/agentkeygate, the nftables rules (meta skuid gateway),
# IAM access to SSM and backup ownership depend on it. A dynamic uid would change on every start.
User=gateway
Group=gateway
EnvironmentFile=/etc/agentkeygate/env
WorkingDirectory=/opt/agentkeygate/app
# DEP0040: the built-in punycode is called by tr46 from the chain grammy -> node-fetch@2; other warnings stay visible.
ExecStart=/usr/bin/node --disable-warning=DEP0040 bin/gateway.js start
Restart=always
RestartSec=3

# ---- hardening ----
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/agentkeygate
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
# Must be no: V8 (JIT) creates executable memory pages; with yes Node will not start.
MemoryDenyWriteExecute=no
LimitCORE=0
LimitNOFILE=65536
UMask=0077

# ---- additional hardening (N-9) ----
# CHECK ON THE SERVER: `systemd-analyze security gateway` (exposure score) and
# `journalctl -u gateway -n 50` after a restart: the unit must start and answer on /healthz.
# Port 8080 and reading /etc/ssl (AWS SDK, TLS to providers) need no privileges:
# ProtectSystem=strict keeps /etc and /usr readable, AF_INET/AF_INET6 are allowed above.
# No capabilities at all: the port is above 1024, raw sockets and changing file owners are not needed.
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
# Other processes are hidden; /proc is limited to process directories (Node reads only /proc/self).
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RemoveIPC=yes
SystemCallArchitectures=native
# System call filter: the @system-service set minus privileged calls.
# Risk: if Node does not start (the journal shows "Bad system call", SIGSYS), remove the second line first.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# @resources (setrlimit, prlimit) is NOT blocked: Node raises RLIMIT_NOFILE with setrlimit at startup,
# so blocking it could break startup. Enable only after testing on the server:
#SystemCallFilter=~@resources
SystemCallErrorNumber=EPERM
# Resource limits. 512M is sized for a VPS with 1 GB RAM and 1 GB swap (the rest: Caddy, OS);
# raise the value if the unit gets OOM-killed. TasksMax limits the number of threads and processes (fork bomb).
MemoryMax=512M
# The gateway must not swap: the swap file exists for the npm build, not for the running service.
MemorySwapMax=0
TasksMax=256

[Install]
WantedBy=multi-user.target
