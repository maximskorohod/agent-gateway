# Copy this file to .env and edit it. .env is excluded from git and from the Docker build context.
# Do not put API keys here: keys are added through the web interface after setup.

# Domain that Caddy serves and gets a Let's Encrypt certificate for.
# Its DNS A record must point to this server, and ports 80 and 443 must be open.
DOMAIN=gw.example.com

# Public address of the gateway as seen from the browser and from agents. Must be https://$DOMAIN.
GW_PUBLIC_URL=https://gw.example.com

# Where API keys are stored. "file" keeps them encrypted in the gateway-data volume,
# with the master key in the same volume. This is the only vault supported by the Docker setup.
GW_VAULT=file

# Interface language: en (default) or ru.
GW_LANG=en

# Time zone used for approval windows and for displayed times.
GW_TZ=UTC

# Log level: fatal, error, warn, info, debug, trace.
GW_LOG_LEVEL=info

# Docker: Caddy runs in another container, so trust the compose network for X-Forwarded-For
GW_TRUST_PROXY=172.16.0.0/12

# Optional settings (MCP limits, demo mode, rate limits and others) are listed in the README, "Configuration".
